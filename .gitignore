# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-cf/
dist-vercel/
dist-netlify/
.netlify/
.vercel/
dist-deno/
build/
docs/dist/
*.d.ts
*.d.ts.map
!packages/runtime-core/src/jsx-types.d.ts
!packages/*/src/env.d.ts
!examples/*/src/*.d.ts
# Shared ambients for the examples' type-check (__DEV__) — sits at the
# examples root, so the per-example exception above does not cover it.
!examples/env.d.ts
# The SHIPPED ambients for the generated virtual: modules (#562). Hand-written,
# and at the package root because `tsc` never copies a .d.ts out of src/ — so
# the blanket rule above would silently drop the one file `@sigx/vite/client`
# publishes.
!packages/vite/client.d.ts
*.js
*.js.map

# Keep specific JS files
!vite.config.js
!*.config.js
!examples/*.js
!scripts/*.js

# TypeScript cache
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/

# Misc
.cache/
.temp/
.tmp/

# benchmark output (pnpm bench:json)
bench-results.json

# SSR benchmark results (pnpm bench:ssr) — only the committed baseline is kept
benchmarks/results/*
!benchmarks/results/baseline.json

# Deno auto-creates a lockfile when running the deploy-smoke entries
examples/*/deno.lock
