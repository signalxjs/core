{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "sigx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "noEmit": true
    },
    // `server.bun.ts` is deliberately OUT of this program: it uses the Bun
    // globals (no @types/bun here) and imports ./dist/server/*.js, which only
    // exist after a build — including it would fail a clean checkout. Its
    // coverage is scripts/deploy-smoke/bun.mjs, which runs it for real (#564).
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts",
        "vite.config.ts",
        "../env.d.ts"
    ],
    // The root config excludes `examples` (its own program is the packages);
    // inheriting that here would exclude this example's OWN sources and the
    // program would resolve to nothing — `tsc -p` then exits on TS18003
    // "No inputs were found", which reads as passing. Override it.
    "exclude": [
        "node_modules",
        "**/dist"
    ]
}
